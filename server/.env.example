# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- Database (MongoDB Atlas free tier works fine) ----
MONGODB_URI=mongodb://127.0.0.1:27017/toolviu

# ---- CORS ----
# IMPORTANT: must contain your website's public URL, exactly as visitors see it (scheme + host, no trailing slash).
# Browsers send an Origin header with POST requests, and the API rejects origins that are not listed.
# Comma separate multiple values, e.g. https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:3000

# ---- Reverse proxy ----
# Number of proxies in front of the API (Next.js rewrite, load balancer, ...). Used to read the real client IP
# for rate limiting. Typical: 1 when the API sits directly behind one proxy, 2 behind Next.js + a platform proxy.
TRUST_PROXY=1

# ---- Share links ----
SNIPPET_TTL_DAYS=30
SNIPPET_MAX_CHARS=200000

# ---- API tester proxy ----
PROXY_TIMEOUT_MS=15000
PROXY_MAX_RESPONSE_BYTES=2097152
PROXY_MAX_REDIRECTS=5
# DANGER: allows the proxy to reach private/internal addresses. Only for local development. Never enable in production.
PROXY_ALLOW_PRIVATE_TARGETS=false

# ---- Rate limits ----
RATE_PROXY_PER_MIN=30
RATE_SHARE_PER_HOUR=60
RATE_FEEDBACK_PER_HOUR=5
RATE_STATS_PER_MIN=120
RATE_GLOBAL_PER_MIN=300
