# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- Database ----
# Local MongoDB running on this same server
MONGODB_URI=mongodb://127.0.0.1:27017/toolviu

# ---- CORS ----
# Must exactly match your real site URL(s) — replace with your actual domain once you have one
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Reverse proxy ----
# 1 proxy in front (Caddy/nginx doing HTTPS) -> Next.js -> this API
TRUST_PROXY=1

# ---- Share links ----
SNIPPET_TTL_DAYS=30
SNIPPET_MAX_CHARS=200000

# ---- API tester proxy ----
PROXY_TIMEOUT_MS=15000
PROXY_MAX_RESPONSE_BYTES=2097152
PROXY_MAX_REDIRECTS=5
PROXY_ALLOW_PRIVATE_TARGETS=false

# ---- Rate limits ----
RATE_PROXY_PER_MIN=30
RATE_SHARE_PER_HOUR=60
RATE_FEEDBACK_PER_HOUR=5
RATE_STATS_PER_MIN=120
RATE_GLOBAL_PER_MIN=300