# ---- Branding ----
NEXT_PUBLIC_SITE_NAME=Toolviu
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=you@yourdomain.com

# ---- Backend API ----
# Same server, so localhost works — Next.js forwards /api/* to this internally
API_URL=http://localhost:5000

# ---- Monetisation & analytics ----
# Leave all blank for now — set these up after you have traffic
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_GA_ID=

# ---- Search engine verification ----
# Fill this in once you register the site with Google Search Console (do this early — it's free and separate from AdSense)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=